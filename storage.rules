rules_version = '2';

// ============================================================
// Vertex Core — Firebase Storage Security Rules
// 2026-05-09 v2: Explicit-path allowlist, default deny.
// 2026-05-15 v3: Slice 59c audit — added teaching_media/ prefix
//   (teaching_layer.js Phase 52a); added 10 MB write-size cap on
//   all paths; verified conversational_timeline.js (Phase 41c)
//   uploads to field_evidence/ (already covered); verified
//   offline_storage_outbox.js (Phase 56a) replays existing paths
//   only (no new prefix needed).  Audit date: 2026-05-15.
// 2026-05-15 v4: Slice 61a — MIME type restrictions added to all
//   write rules.  Audit date: 2026-05-15.
//   • PHOTO-ONLY paths accept image/.* only (covers HEIC/HEIF).
//   • MEDIA paths (field_evidence, service_call_addendums) accept
//     image/.* or video/.* — technician captures both media types.
//   • MEDIA+AUDIO path (teaching_media) accepts image/.*, video/.*,
//     or audio/.* — knowledge base supports all three.
//   Use .matches() prefix patterns (not == exact match) so all
//   image subtypes (HEIC, WEBP, PNG, etc.) are covered.
//
// Design mirrors firestore.rules: each known upload prefix is
// listed individually; everything else is denied by default
// (no catch-all /{allPaths=**} on the bucket root).
//
// App runs without Firebase Auth on field + dispatcher flows,
// so allowed paths use `if true`.  Restrict to
// `request.auth != null` once Auth is rolled out (ADR-012).
//
// Known upload prefixes (grep *.js AND *.html for firebase.storage().ref):
//   equipment_manager.js      → equipment_photos/, dictation_hub_assets/
//   unit_work_parser.js       → equipment_photos/
//   service_call.js           → customer_evidence/
//   field_forms.js            → field_quote_evidence/, field_form_evidence/, quote_evidence/
//   workspace_ui.js           → site_access_photos/
//   dictation_hub.js          → tenants/{tid}/imported_equipment_photos/
//   technician/index.html     → field_evidence/, service_call_addendums/
//   conversational_timeline.js → field_evidence/ (Phase 41c — same prefix as above)
//   teaching_layer.js         → teaching_media/ (Phase 52a)
//   offline_storage_outbox.js → replays rec.storagePath (Phase 56a — no new prefix)
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Equipment profile photos (Equipment Manager + UWP inline quick-add)
    match /equipment_photos/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Dictation Hub asset photos (nameplate promotion, watermarked assets)
    match /dictation_hub_assets/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Customer evidence attachments (service call — dispatcher + field app)
    match /customer_evidence/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Field quote mandatory evidence photos
    match /field_quote_evidence/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Field form dynamic question photo uploads
    match /field_form_evidence/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Repair quote photos
    match /quote_evidence/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Site Intel access photos (workspace panel — workspace_ui.js)
    match /site_access_photos/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Vision Hub imported equipment nameplate photos (tenant-scoped)
    match /tenants/{tenantId}/imported_equipment_photos/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Field-app pasted photo evidence + conversational timeline media capture
    // (technician/index.html + conversational_timeline.js Phase 41c)
    // Accepts image or video — technician captures both media types.
    match /field_evidence/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Service call addendum file attachments (addendums flow — technician/index.html)
    // Accepts image or video — addendum evidence can be photo or video clip.
    match /service_call_addendums/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Teaching Layer knowledge media uploads (teaching_layer.js Phase 52a)
    // Accepts image, video, or audio — knowledge base supports all three media types.
    match /teaching_media/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('audio/.*'));
    }

    // Generic file attachments from Choose File (PDFs, docs, etc.)
    // No MIME restriction — file type is user-controlled; size cap enforced.
    // Added Phase61-AddMedia-2026-05-16.
    match /service_call_files/{allPaths=**} {
      allow read:  if true;
      allow write: if true
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // All other paths: default deny (no match = no access).
    // Add a new explicit block above when a new upload prefix is introduced.
    // Grep *.js AND *.html for `firebase.storage().ref` when adding new upload features.

  }
}
