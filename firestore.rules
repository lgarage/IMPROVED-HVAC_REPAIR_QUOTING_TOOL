rules_version = '2';

// ============================================================
// Vertex Core — Firestore Security Rules
// Slice 1 (Per-User Feature Toggles foundation) — 2026-05-06
// Slice 59b — Security tightening: REVERTED 2026-05-15.
//   Field techs do NOT use Firebase Auth (roster pick from localStorage).
//   59b gated all tenant/data paths on request.auth != null, breaking the
//   tech app (presence offline, schedule subscription denied).
//   All field-tech-accessible paths restored to if true pending
//   implementation of anonymous-auth or custom-token flow.
// ============================================================
//
// v1 STRATEGY (Slice 1): lock down admin surfaces only.
// v2 STRATEGY (post-59b revert): admin locks (Slice 1) remain;
// all data/tenant paths stay open (if true) because the field
// tech app has no Firebase Auth identity today. A future slice
// will add anonymous auth or custom tokens before re-tightening.
//
// Locked admin surfaces (unchanged from Slice 1):
//   • tenants/{tid}/config/entitlements          (write = admin)
//   • tenants/{tid}/admins/{adminDoc}            (write = admin)
//   • tenants/{tid}/users/{uid}.featureOverrides (write = admin)
//
// See DECISIONS.md → ADR-015 for the rationale.
//
// ⚠️  BEFORE FIRST DEPLOY:
//   1. Add at least one admin email to the inline list inside
//      isBootstrapAdmin() below (the only place rules read from).
//   2. Run `firebase deploy --only firestore:rules`.
//   3. Sign in to dispatcher with that email; from there you can
//      add more admin uids to tenants/{tid}/admins/by_uid.uids
//      via the Slice 3 admin UI (or Firebase Console).
//
// ⚠️  RULE EVALUATION SEMANTICS:
//   Firestore OR-combines all matching `allow` expressions — a
//   permissive `match /{document=**} { allow ...: if true; }`
//   would override the locks below. This file therefore lists
//   each open path explicitly and has NO catch-all allow.
//   Anything not matched falls through to default-deny.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers --------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      // Edit this list to seed the first admin(s). Lower-case the
      // email; Firebase Auth tokens carry the email exactly as
      // entered at sign-in, but custom claim `email` matches the
      // signup form. Keep this list short — long-term admin state
      // belongs in tenants/{tid}/admins/by_uid.
      // email_verified check omitted for bootstrap admins — the email is
      // hardcoded in this rules file (deploy-gated), so it is already trusted.
      return isSignedIn()
        && request.auth.token.email in [
          "dan.day@blackduckpartners.com"
        ];
    }

    function isStoredAdmin(tid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/tenants/$(tid)/admins/by_uid)
        && get(/databases/$(database)/documents/tenants/$(tid)/admins/by_uid).data.uids[request.auth.uid] == true;
    }

    function isAdmin(tid) {
      return isBootstrapAdmin() || isStoredAdmin(tid);
    }

    // ----- LOCKED: tenant entitlements (Slice 1 target) ------
    match /tenants/{tid}/config/entitlements {
      allow read: if true;
      allow write: if isAdmin(tid);
    }

    // ----- LOCKED: tenant admin list (Slice 1 target) --------
    // Read requires sign-in (don't leak the admin list to
    // anonymous callers). Write requires admin.
    match /tenants/{tid}/admins/{adminDoc} {
      allow read: if isSignedIn();
      allow write: if isAdmin(tid);
    }

    // ----- LOCKED: user.featureOverrides field --------------
    // The user document itself stays readable by anyone (the
    // field app's vc_entitlements.js currently reads it without
    // auth to determine Lite-seat / sandbox state). Writes that
    // touch `featureOverrides` require admin; writes that don't
    // (e.g. dispatcher CSV import setting role / payrollNameUpper)
    // keep the open default.
    match /tenants/{tid}/users/{uid} {
      allow read: if true;
      allow create: if !('featureOverrides' in request.resource.data) || isAdmin(tid);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featureOverrides']) || isAdmin(tid);
      allow delete: if isAdmin(tid);
    }

    // ----- Tenant config OTHER than entitlements ------------
    // (entitlements is locked above; everything else open for now.)
    match /tenants/{tid}/config/{configDoc} {
      allow read, write: if configDoc != "entitlements";
    }

    // ----- LOCKED: review edits on completed reports (Phases 47–52) ---
    // Admin QA annotations on completed reports; techs can read.
    match /tenants/{tid}/completed_reports/{id}/review_edits/{autoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(tid);
    }

    // ----- LOCKED: learning data (Phases 47–52) ------------------
    // Field app auto-uploads learning data; only admins review it.
    match /tenants/{tid}/learning_data/{autoId} {
      allow read: if isAdmin(tid);
      allow write: if isSignedIn();
    }

    // ----- LOCKED: knowledge / teaching notes (Phases 47–52) -----
    // Techs create teaching notes; all authenticated users can read.
    match /tenants/{tid}/knowledge/{autoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ============================================================
    // Data paths — open (if true). Field tech app has NO Firebase
    // Auth identity; all reads/writes are unauthenticated.
    // 59b attempted request.auth != null here; reverted 2026-05-15
    // because it broke presence, schedule, and all field writes.
    // Re-tighten ONLY after implementing anon-auth / custom tokens.
    // ============================================================

    // ----- Tenant subcollections ----------------------------
    match /tenants/{tid}/service_calls/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/site_intelligence/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/live_presence/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/imported_equipment/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/imported_equipment_photos/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/labor_logs/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/portal_tokens/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/roster/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/field_quotes/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/office_quotes/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/vendors/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/pm_records/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/field_form_submissions/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/on_call_state/{document=**} {
      allow read, write: if true;
    }
    match /tenants/{tid}/completed_reports/{docId} {
      allow read, write: if true;
    }
    match /tenants/{tid}/sandbox/{document=**} {
      allow read, write: if true;
    }

    // ----- Root legacy bridge collections (TWIN_PILLARS) -----
    // Lazy-migration bridge per ADR-003.
    match /service_calls/{document=**} {
      allow read, write: if true;
    }
    match /site_intelligence/{document=**} {
      allow read, write: if true;
    }
    match /completed_reports/{document=**} {
      allow read, write: if true;
    }

    // ----- Root legacy paths still accessed today -----------
    match /Customers/{document=**} {
      allow read, write: if true;
    }
    match /customers/{document=**} {
      allow read, write: if true;
    }
    match /customers/{cid}/sites/{sid}/assets/{document=**} {
      allow read, write: if true;
    }
    match /ParentCompanies/{document=**} {
      allow read, write: if true;
    }
    match /MappedLocations/{document=**} {
      allow read, write: if true;
    }
    match /invoices/{document=**} {
      allow read, write: if true;
    }
    match /metadata/{document=**} {
      allow read, write: if true;
    }
    // form_templates: field app reads templates; admin mode saves from mobile (no Firebase Auth on tech app yet — ADR-015)
    match /form_templates/{document=**} {
      allow read, write: if true;
    }
    // app_config: public read (technician roster, public config)
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
